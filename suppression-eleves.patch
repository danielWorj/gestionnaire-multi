         return {"message": "Supprimé avec succès"}, 200
+    except IntegrityError as e:
+        db.session.rollback()
+        # Une clé étrangère (ou une contrainte NOT NULL sur la clé de
+        # rattachement) empêche la suppression : l'élément est encore utilisé
