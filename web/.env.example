# Par défaut le front appelle '/api' (même origine) via le proxy Vite,
# ce qui évite les problèmes de cookies JWT/CSRF entre localhost et 127.0.0.1.
# Cible du proxy en dev :
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
# À ne définir que si l'API est servie sur un autre domaine (CORS + cookies) :
# VITE_API_BASE_URL=https://api.example.com/api
