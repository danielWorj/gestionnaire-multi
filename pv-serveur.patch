diff --git a/server/services/pv_services.py b/server/services/pv_services.py
new file mode 100644
index 0000000..4a56fe3
--- /dev/null
+++ b/server/services/pv_services.py
@@ -0,0 +1,303 @@
+import re
+from decimal import Decimal, ROUND_DOWN
+
+from models.evaluation_models import Note
+from models.inscription_models import Inscription, STATUTS_INSCRIPTION_EN_COURS
+from models.pedagogie_models import MatiereClasse, TitulaireClasse
+from models.structure_models import Classe, AnneeScolaire, Trimestre, Sequence
+
+
+# ---------------------------------------------------------------------------
+# Procès-verbal d'évaluation (« Contrôle continu N°x ») : le tableau de toute
+# une classe pour UNE séquence, tel qu'il est tenu à la main (A4 paysage).
+#
+# Module INDÉPENDANT du bulletin (aucun import de bulletin_services) : le PV a
+# ses propres règles, qui diffèrent de celles du bulletin individuel :
+#
+#   - cellule d'une matière = note /20 × coefficient (points pondérés) ;
+#   - Totaux = somme des cellules ;
+#   - moyenne = Totaux ÷ Σ coefficients de TOUTES les matières de la classe
+#     (dénominateur fixe, le même pour tous les élèves) ;
+#   - la moyenne est TRONQUÉE à 2 décimales, jamais arrondie (11,6985 -> 11,69) ;
+#   - rang = 1 + nombre d'élèves classés strictement meilleurs, calculé sur la
+#     valeur exacte (D2) ; ex æquo au même rang ;
+#   - note « absent » = 0 (D3) : l'élève reste classé ;
+#   - note non saisie (aucune ligne Note, ou ligne sans valeur et sans
+#     absence) = élève NON CLASSÉ (N.C.) : total partiel affiché, ni moyenne
+#     ni rang (D4) ;
+#   - rouge pour toute note < 10 (D5), moyenne comprise ;
+#   - seuls les élèves en cours (Actif, Suspendu) figurent au PV (D7).
+#
+# Tous les calculs se font en Decimal ; les chaînes *_fmt sont produites ici :
+# le gabarit et le front n'ont aucun calcul à faire.
+# ---------------------------------------------------------------------------
+
+CENT = Decimal('0.01')
+SEUIL_ROUGE = Decimal('10')
+
+
+class PvErreur(Exception):
+    def __init__(self, message, status=400):
+        super().__init__(message)
+        self.message = message
+        self.status = status
+
+
+# --- Utilitaires de calcul et de formatage ---------------------------------
+
+def tronquer_2(valeur):
+    """Troncature (et non arrondi) à 2 décimales : 13.45588 -> 13.45."""
+    return Decimal(valeur).quantize(CENT, rounding=ROUND_DOWN)
+
+
+def fmt_points(valeur):
+    """Virgule décimale, 2 décimales au plus, sans zéros inutiles :
+    42.50 -> « 42,5 », 26.00 -> « 26 », 27.75 -> « 27,75 »."""
+    if valeur is None:
+        return ''
+    texte = format(Decimal(valeur).quantize(CENT, rounding=ROUND_DOWN), 'f')
+    if '.' in texte:
+        texte = texte.rstrip('0').rstrip('.')
+    return texte.replace('.', ',')
+
+
+def fmt_moyenne(valeur):
+    """Moyenne sur 2 chiffres entiers et 2 décimales : 8.88 -> « 08,88 »."""
+    if valeur is None:
+        return ''
+    return format(Decimal(valeur), '05.2f').replace('.', ',')
+
+
+def fmt_rang(rang, sexe=None):
+    """1 -> « 1er » / « 1ère » (selon le sexe) ; sinon « 8e », « 19e »."""
+    if rang is None:
+        return ''
+    if rang == 1:
+        return '1ère' if sexe == 'F' else '1er'
+    return f"{rang}e"
+
+
+def nom_affiche(nom, prenom):
+    """NOM en majuscules + prénom en casse titre : « DILOGA Samira »."""
+    prenom = (prenom or '').strip()
+    return f"{(nom or '').strip().upper()} {prenom.title()}".strip()
+
+
+def abreviation_matiere(matiere):
+    """Libellé court de l'en-tête : abréviation saisie, à défaut les 5
+    premiers caractères du libellé."""
+    court = (matiere.abreviation or '').strip() if matiere else ''
+    return court or ((matiere.libelle or '').strip()[:5] if matiere else '')
+
+
+def _rangs(valeurs_par_id):
+    """{id: valeur|None} -> {id: rang|None}, rang = 1 + nombre de valeurs
+    strictement supérieures (ex æquo au même rang). Propre au PV."""
+    classees = [v for v in valeurs_par_id.values() if v is not None]
+    return {cle: (None if v is None else 1 + sum(1 for autre in classees if autre > v))
+            for cle, v in valeurs_par_id.items()}
+
+
+def _en_float(valeur):
+    return float(valeur) if valeur is not None else None
+
+
+def classe_label(classe):
+    cycle = classe.cycle.libelle if classe.cycle else None
+    if cycle and classe.option:
+        return f"{cycle} {classe.option}"
+    return cycle or classe.option or f"Classe #{classe.id}"
+
+
+def titre_sequence(sequence):
+    """'Séquence 2' -> « CONTRÔLE CONTINU N°2 » ; sans numéro, le libellé en
+    majuscules."""
+    trouve = re.search(r'(\d+)\s*$', sequence.libelle or '')
+    return f"CONTRÔLE CONTINU N°{trouve.group(1)}" if trouve else (sequence.libelle or '').upper()
+
+
+# --- Séquences --------------------------------------------------------------
+
+def sequences_de_l_annee(etablissement, annee_id):
+    """Séquences d'une année scolaire de l'établissement, dans l'ordre
+    (trimestre, séquence). Lève PvErreur 404 si l'année est introuvable."""
+    annee = AnneeScolaire.query.filter_by(id=annee_id, etablissement_id=etablissement.id).first() \
+        if annee_id else None
+    if not annee:
+        raise PvErreur("Année scolaire introuvable", 404)
+    sequences = (
+        Sequence.query
+        .join(Trimestre, Trimestre.id == Sequence.trimestre_id)
+        .filter(Trimestre.annee_scolaire_id == annee.id)
+        .order_by(Trimestre.id, Sequence.id)
+        .all()
+    )
+    return [{"id": s.id, "libelle": s.libelle, "titre": titre_sequence(s),
+             "trimestre_id": s.trimestre_id, "trimestre": s.trimestre.libelle if s.trimestre else None}
+            for s in sequences]
+
+
+# --- Construction du PV -----------------------------------------------------
+
+def construire_pv(etablissement, classe_id, annee_id, sequence_id, ordre='alphabetique'):
+    """Calcule le PV d'une classe pour une séquence. Lève PvErreur (404) si la
+    classe, l'année ou la séquence est introuvable / hors établissement."""
+    classe = Classe.query.get(classe_id) if classe_id else None
+    if not classe or classe.etablissement_id != etablissement.id:
+        raise PvErreur("Classe introuvable", 404)
+
+    annee = AnneeScolaire.query.filter_by(id=annee_id, etablissement_id=etablissement.id).first() \
+        if annee_id else None
+    if not annee:
+        raise PvErreur("Année scolaire introuvable", 404)
+
+    sequence = (
+        Sequence.query
+        .join(Trimestre, Trimestre.id == Sequence.trimestre_id)
+        .filter(Sequence.id == sequence_id, Trimestre.annee_scolaire_id == annee.id)
+        .first()
+    ) if sequence_id else None
+    if not sequence:
+        raise PvErreur("Séquence introuvable pour cette année scolaire", 404)
+
+    inscriptions = Inscription.query.filter(
+        Inscription.classe_id == classe.id, Inscription.annee_scolaire_id == annee.id,
+        Inscription.statut.in_(STATUTS_INSCRIPTION_EN_COURS),
+    ).all()
+    insc_ids = [i.id for i in inscriptions]
+
+    matieres_classe = MatiereClasse.query.filter_by(classe_id=classe.id).all()
+
+    # Colonnes : ordre du groupe de matières, puis libellé (insensible à la casse).
+    def _cle_matiere(mc):
+        groupe = mc.matiere.groupe if mc.matiere else None
+        return ((groupe.ordre, groupe.libelle.lower()) if groupe else (10**9, ''),
+                (mc.matiere.libelle if mc.matiere else '').lower(), mc.id)
+
+    matieres_classe.sort(key=_cle_matiere)
+    mc_ids = [mc.id for mc in matieres_classe]
+    total_coef = sum(mc.coefficient for mc in matieres_classe)
+
+    notes = {}
+    if insc_ids and mc_ids:
+        for n in Note.query.filter(Note.inscription_id.in_(insc_ids), Note.matiere_classe_id.in_(mc_ids),
+                                   Note.sequence_id == sequence.id).all():
+            notes[(n.inscription_id, n.matiere_classe_id)] = n
+
+    titulaire = TitulaireClasse.query.filter_by(classe_id=classe.id, annee_scolaire_id=annee.id).first()
+
+    # --- Calcul par élève (Decimal partout) ---------------------------------
+    lignes = []
+    manquantes_par_matiere = {mc.id: 0 for mc in matieres_classe}
+    for insc in inscriptions:
+        total = Decimal('0')
+        manquantes = []
+        cellules = []
+        for mc in matieres_classe:
+            ligne = notes.get((insc.id, mc.id))
+            if ligne is None or (ligne.valeur is None and not ligne.absent):
+                manquantes.append(mc.id)
+                manquantes_par_matiere[mc.id] += 1
+                cellules.append({"mc_id": mc.id, "note": None, "points": None, "points_fmt": "", "note_fmt": "",
+                                 "statut": "manquante", "rouge": False})
+                continue
+            note = Decimal('0') if ligne.absent else Decimal(str(ligne.valeur))   # absent = 0 (D3)
+            points = note * Decimal(mc.coefficient)
+            total += points
+            cellules.append({"mc_id": mc.id, "note": _en_float(note), "points": _en_float(points),
+                             "points_fmt": fmt_points(points),
+                             "note_fmt": fmt_points(note),
+                             "statut": "absent" if ligne.absent else "ok",
+                             "rouge": note < SEUIL_ROUGE})                         # D5
+
+        # Sans matière (total_coef = 0) aucune moyenne n'a de sens : N.C.
+        classe_ok = not manquantes and total_coef > 0
+        moyenne_exacte = total / Decimal(total_coef) if classe_ok else None
+        moyenne = tronquer_2(moyenne_exacte) if classe_ok else None
+        motif = None
+        if not classe_ok:
+            motif = ("Aucune matière affectée à la classe" if total_coef == 0
+                     else f"{len(manquantes)} note(s) manquante(s)")
+        lignes.append({"insc": insc, "cellules": cellules, "total": total,
+                       "exacte": moyenne_exacte, "moyenne": moyenne,
+                       "classe": classe_ok, "motif": motif})
+
+    rangs = _rangs({l["insc"].id: l["exacte"] for l in lignes})   # D2 : valeur exacte
+
+    # --- Tri puis numérotation (le N° suit l'ordre alphabétique) -----------
+    def _cle_alpha(l):
+        e = l["insc"].eleve
+        return (e.nom.casefold(), (e.prenom or '').casefold(), l["insc"].id)
+
+    alphabetique = sorted(lignes, key=_cle_alpha)
+    numeros = {l["insc"].id: i for i, l in enumerate(alphabetique, start=1)}
+    if ordre == 'rang':
+        ordonnees = sorted(lignes, key=lambda l: (rangs[l["insc"].id] is None,
+                                                  rangs[l["insc"].id] or 0, _cle_alpha(l)))
+    else:
+        ordonnees = alphabetique
+
+    eleves = []
+    for l in ordonnees:
+        insc = l["insc"]
+        e = insc.eleve
+        rang = rangs[insc.id]
+        eleves.append({
+            "numero": numeros[insc.id],
+            "inscription_id": insc.id,
+            "eleve_id": e.id,
+            "nom": e.nom, "prenom": e.prenom, "sexe": e.sexe,
+            "nom_affiche": nom_affiche(e.nom, e.prenom),
+            "cellules": l["cellules"],
+            "total": _en_float(l["total"]), "total_fmt": fmt_points(l["total"]),
+            "moyenne": _en_float(l["moyenne"]), "moyenne_fmt": fmt_moyenne(l["moyenne"]),
+            "moyenne_rouge": l["exacte"] is not None and l["exacte"] < SEUIL_ROUGE,
+            "rang": rang, "rang_fmt": fmt_rang(rang, e.sexe) if rang is not None else "N.C.",
+            "classe": l["classe"], "nc_motif": l["motif"],
+        })
+
+    # --- Statistiques et alertes --------------------------------------------
+    classees = [l for l in lignes if l["classe"]]
+    exactes = [l["exacte"] for l in classees]
+    nb_sup_10 = sum(1 for m in exactes if m >= SEUIL_ROUGE)
+    statistiques = {
+        "moyenne_classe": _en_float(tronquer_2(sum(exactes) / len(exactes))) if exactes else None,
+        "moyenne_min": _en_float(tronquer_2(min(exactes))) if exactes else None,
+        "moyenne_max": _en_float(tronquer_2(max(exactes))) if exactes else None,
+        "nb_classes": len(classees),
+        "nb_sup_10": nb_sup_10,
+        "nb_inf_10": len(classees) - nb_sup_10,
+        "taux_reussite": round(100 * nb_sup_10 / len(classees), 1) if classees else None,
+        "nb_non_classes": len(lignes) - len(classees),
+    }
+    statistiques["moyenne_classe_fmt"] = fmt_moyenne(tronquer_2(sum(exactes) / len(exactes))) if exactes else ""
+    statistiques["moyenne_min_fmt"] = fmt_moyenne(tronquer_2(min(exactes))) if exactes else ""
+    statistiques["moyenne_max_fmt"] = fmt_moyenne(tronquer_2(max(exactes))) if exactes else ""
+    statistiques["taux_reussite_fmt"] = (str(statistiques["taux_reussite"]).replace('.', ',')
+                                         if statistiques["taux_reussite"] is not None else "")
+    alertes = [{"mc_id": mc.id, "matiere": mc.matiere.libelle if mc.matiere else f"Matière #{mc.matiere_id}",
+                "manquantes": manquantes_par_matiere[mc.id]}
+               for mc in matieres_classe if manquantes_par_matiere[mc.id]]
+
+    return {
+        "etablissement": {
+            "nom": etablissement.nom, "bp": etablissement.bp, "telephone": etablissement.telephone,
+            "region": etablissement.region, "adresse": etablissement.adresse, "logo": etablissement.logo,
+        },
+        "classe": {"id": classe.id, "label": classe_label(classe)},
+        "annee": {"id": annee.id, "libelle": annee.libelle},
+        "sequence": {"id": sequence.id, "libelle": sequence.libelle, "titre": titre_sequence(sequence)},
+        "titulaire": (f"{titulaire.enseignant.nom} {titulaire.enseignant.prenom}".strip()
+                      if titulaire and titulaire.enseignant else None),
+        "effectif": len(inscriptions),
+        "total_coef": total_coef,
+        "matieres": [{"mc_id": mc.id,
+                      "libelle": mc.matiere.libelle if mc.matiere else f"Matière #{mc.matiere_id}",
+                      "abreviation": abreviation_matiere(mc.matiere),
+                      "coefficient": mc.coefficient,
+                      "groupe": mc.matiere.groupe.libelle if mc.matiere and mc.matiere.groupe else None}
+                     for mc in matieres_classe],
+        "eleves": eleves,
+        "statistiques": statistiques,
+        "alertes": alertes,
+    }
diff --git a/server/static/templates/pv/pv_evaluation.html b/server/static/templates/pv/pv_evaluation.html
new file mode 100644
index 0000000..51bc73d
--- /dev/null
+++ b/server/static/templates/pv/pv_evaluation.html
@@ -0,0 +1,148 @@
+{#- Procès-verbal d'évaluation (« Contrôle continu N°x »).
+    Gabarit unique pour l'aperçu HTML et le PDF (WeasyPrint), cf. api/pv_api.py.
+    Données : pv_services.construire_pv. AUCUN calcul ici : les chaînes
+    *_fmt viennent du serveur. Propre au PV (rien de commun avec le bulletin). -#}
+{%- set etab = data.etablissement -%}
+{%- set nb_mat = data.matieres | length -%}
+<!DOCTYPE html>
+<html lang="fr">
+<head>
+<meta charset="utf-8">
+<title>PV — {{ data.classe.label }} — {{ data.sequence.titre }}</title>
+<style>
+  @page {
+    size: A4 landscape; margin: 8mm;
+    @bottom-right { content: "Page " counter(page) " / " counter(pages); font-family: "DejaVu Sans", Arial, sans-serif; font-size: 6.5pt; color: #555; }
+  }
+  * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
+  body { margin: 0; font-family: "DejaVu Sans", Arial, Helvetica, sans-serif; color: #111;
+         font-size: {{ police }}pt; }
+  @media screen {
+    body { background: #e9ebee; padding: 14px 0; }
+    .page { width: 297mm; margin: 0 auto; padding: 8mm; background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,.18); }
+  }
+  table { border-collapse: collapse; width: 100%; }
+  .entete td { vertical-align: top; text-align: center; font-size: 7.4pt; line-height: 1.35; }
+  .entete .gauche { text-align: left; width: 33%; }
+  .entete .droite { text-align: right; width: 33%; }
+  .entete .etab { font-weight: 700; font-size: 8.6pt; text-transform: uppercase; }
+  .entete .logo { max-height: 15mm; max-width: 22mm; vertical-align: middle; margin-right: 2mm; }
+  h1 { text-align: center; font-size: 13pt; margin: 2mm 0 1.5mm; letter-spacing: .04em; }
+  .contexte td { font-weight: 700; font-size: 9.5pt; padding: 0 0 2mm; }
+  .contexte .c { text-align: center; }
+  .contexte .d { text-align: right; }
+
+  table.pv { table-layout: fixed; }
+  table.pv th, table.pv td { border: 0.4pt solid #222; text-align: center; padding: 0.6mm 0.3mm; }
+  table.pv thead { display: table-header-group; }
+  table.pv tr { break-inside: avoid; page-break-inside: avoid; }
+  table.pv th { font-weight: 700; background: #f1f1f1; }
+  th.num { width: 6mm; }
+  th.nom { width: 46mm; }
+  th.fin { width: 13mm; }
+  th.rang { width: 11mm; }
+  /* En-têtes de matières verticaux (comme sur le PV papier) */
+  th.mat { height: 19mm; padding: 0; position: relative; vertical-align: bottom; }
+  th.mat span { display: block; position: absolute; left: 50%; bottom: 1mm; white-space: nowrap;
+                transform-origin: 0 100%; transform: rotate(-90deg) translateY(50%); font-size: 6.6pt; }
+  tr.coef td, tr.coef th { background: #f7f7f7; font-weight: 700; }
+  table.pv td.nom { text-align: left; padding-left: 1.2mm; white-space: nowrap; overflow: hidden; }
+  td.nombre { font-variant-numeric: tabular-nums; }
+  .rouge { color: #c00; }
+  td.nc, td.nc-rang { color: #555; }
+  td.total, td.moy, td.rang { font-weight: 700; }
+
+  .pied { margin-top: 3mm; font-size: 7.4pt; break-inside: avoid; page-break-inside: avoid; }
+  .pied .stats { margin-bottom: 3mm; }
+  .pied .stats span { margin-right: 6mm; }
+  .signatures td { width: 33%; text-align: center; height: 20mm; vertical-align: top; font-weight: 700; border: 0; }
+  .edition { text-align: right; font-size: 6.8pt; color: #555; margin-top: 1mm; }
+</style>
+</head>
+<body>
+<div class="page">
+
+  <table class="entete"><tr>
+    <td class="gauche">
+      {%- if logo_src %}<img class="logo" src="{{ logo_src }}" alt="">{% endif -%}
+      <span class="etab">{{ etab.nom }}</span>
+    </td>
+    <td></td>
+    <td class="droite">
+      {%- if etab.bp %}{{ etab.bp }}{% if etab.region %} — {{ etab.region }}{% endif %}<br>{% endif -%}
+      {%- if etab.telephone %}Tél : {{ etab.telephone }}{% endif -%}
+    </td>
+  </tr></table>
+
+  <h1>PROCÈS VERBAL D'ÉVALUATION</h1>
+
+  <table class="contexte"><tr>
+    <td>{{ data.sequence.titre }}</td>
+    <td class="c">Classe : {{ data.classe.label }}</td>
+    <td class="d">Effectif : {{ data.effectif }}</td>
+  </tr></table>
+
+  <table class="pv">
+    <thead>
+      <tr>
+        <th class="num" rowspan="2">N°</th>
+        <th class="nom" rowspan="2">Noms et prénoms</th>
+        {%- for m in data.matieres %}
+        <th class="mat"><span>{{ m.abreviation }}</span></th>
+        {%- endfor %}
+        <th class="fin" rowspan="2">Totaux</th>
+        <th class="fin" rowspan="2">moy</th>
+        <th class="rang" rowspan="2">rang</th>
+      </tr>
+      <tr class="coef">
+        {%- for m in data.matieres %}
+        <td>{{ m.coefficient }}</td>
+        {%- endfor %}
+      </tr>
+    </thead>
+    <tbody>
+      {%- for e in data.eleves %}
+      <tr>
+        <td>{{ e.numero }}</td>
+        <td class="nom">{{ e.nom_affiche }}</td>
+        {%- for c in e.cellules %}
+        {%- if c.statut == 'manquante' %}
+        <td class="nc">/</td>
+        {%- else %}
+        <td class="nombre{{ ' rouge' if c.rouge }}">{{ (c.note_fmt if valeurs == 'notes' else c.points_fmt) }}</td>
+        {%- endif %}
+        {%- endfor %}
+        <td class="total nombre">{{ e.total_fmt }}</td>
+        {%- if e.classe %}
+        <td class="moy nombre{{ ' rouge' if e.moyenne_rouge }}">{{ e.moyenne_fmt }}</td>
+        <td class="rang">{{ e.rang_fmt }}</td>
+        {%- else %}
+        <td class="moy nc">/</td>
+        <td class="rang nc-rang">N.C.</td>
+        {%- endif %}
+      </tr>
+      {%- endfor %}
+    </tbody>
+  </table>
+
+  <div class="pied">
+    {%- if data.statistiques.nb_classes %}
+    <div class="stats">
+      <span>Moyenne de la classe : <b>{{ data.statistiques.moyenne_classe_fmt }}</b></span>
+      <span>Plus forte : <b>{{ data.statistiques.moyenne_max_fmt }}</b></span>
+      <span>Plus faible : <b>{{ data.statistiques.moyenne_min_fmt }}</b></span>
+      <span>Moyennes ≥ 10 : <b>{{ data.statistiques.nb_sup_10 }}</b> ({{ data.statistiques.taux_reussite_fmt }} %)</span>
+      {%- if data.statistiques.nb_non_classes %}<span>Non classés : <b>{{ data.statistiques.nb_non_classes }}</b></span>{% endif %}
+    </div>
+    {%- endif %}
+    <table class="signatures"><tr>
+      <td>Le professeur principal{% if data.titulaire %}<br><span style="font-weight:400">{{ data.titulaire }}</span>{% endif %}</td>
+      <td>Le censeur</td>
+      <td>Le chef d'établissement</td>
+    </tr></table>
+    <div class="edition">Édité le {{ date_edition }}</div>
+  </div>
+
+</div>
+</body>
+</html>
diff --git a/server/tests/test_pv.py b/server/tests/test_pv.py
new file mode 100644
index 0000000..916c630
--- /dev/null
+++ b/server/tests/test_pv.py
@@ -0,0 +1,395 @@
+"""Procès-verbal d'évaluation : calcul (Decimal, troncature, N.C., absent = 0,
+rangs), formats, rouge < 10, effectif, droits (Admin/SuperAdmin), HTML et PDF."""
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from extensions import db
+from models.authentification_models import Role
+from models.evaluation_models import Note
+from models.inscription_models import Eleve, Inscription
+from models.pedagogie_models import Matiere, MatiereClasse
+from services.authentification_services import create_utilisateur
+from services.pv_services import (construire_pv, fmt_moyenne, fmt_points, fmt_rang, nom_affiche,
+                                  tronquer_2, abreviation_matiere)
+from models.structure_models import Etablissement
+
+# Jeu issu du PV papier (coef total 34) : (total, moyenne affichée, rang photo).
+PHOTO = [
+    ('397.75', '11.69'), ('418.25', '12.30'), ('302', '08.88'), ('441.5', '12.98'),
+    ('325.75', '09.58'), ('366.5', '10.77'), ('423.25', '12.44'), ('323.25', '09.50'),
+    ('280.25', '08.24'), ('346.75', '10.19'), ('349.25', '10.27'), ('333.5', '09.80'),
+    ('457.5', '13.45'), ('528', '15.52'), ('396', '11.64'), ('419', '12.32'), ('271.5', '07.98'),
+]
+
+
+# ---------------------------------------------------------------------------
+# Outils
+# ---------------------------------------------------------------------------
+
+def _matiere(monde, libelle, coef, abreviation=None):
+    etab = db.session.get(Etablissement, monde.etab_id)
+    groupe_id = db.session.get(Matiere, monde.matiere_id).groupe_id
+    mat = Matiere(etablissement_id=etab.id, libelle=libelle, groupe_id=groupe_id, abreviation=abreviation)
+    db.session.add(mat)
+    db.session.flush()
+    mc = MatiereClasse(classe_id=monde.classe_id, matiere_id=mat.id, enseignant_id=monde.enseignant_id,
+                       coefficient=coef)
+    db.session.add(mc)
+    db.session.commit()
+    return mc.id
+
+
+def _coef(monde, coef):
+    """Coefficient de la matière-classe de base du monde de test."""
+    db.session.get(MatiereClasse, monde.mc_id).coefficient = coef
+    db.session.commit()
+
+
+def _eleve(monde, nom, prenom='X', sexe='M', statut='Actif'):
+    e = Eleve(etablissement_id=monde.etab_id, matricule=f'M-{nom}-{prenom}', nom=nom, prenom=prenom, sexe=sexe,
+              lieu_naissance='Douala', parent_id=monde.parent_id)
+    db.session.add(e)
+    db.session.flush()
+    insc = Inscription(eleve_id=e.id, classe_id=monde.classe_id, annee_scolaire_id=monde.annee_id,
+                       date_inscription=date(2026, 9, 1), statut=statut)
+    db.session.add(insc)
+    db.session.commit()
+    return insc.id
+
+
+def _note(monde, insc_id, mc_id, valeur=None, absent=False):
+    db.session.add(Note(inscription_id=insc_id, matiere_classe_id=mc_id, sequence_id=monde.sequence_id,
+                        valeur=Decimal(str(valeur)) if valeur is not None else None, absent=absent))
+    db.session.commit()
+
+
+def _pv(monde, ordre='alphabetique'):
+    return construire_pv(db.session.get(Etablissement, monde.etab_id), monde.classe_id, monde.annee_id,
+                         monde.sequence_id, ordre)
+
+
+def _ligne(pv, nom):
+    return next(e for e in pv["eleves"] if e["nom"] == nom)
+
+
+def _cell(ligne, mc_id):
+    return next(c for c in ligne["cellules"] if c["mc_id"] == mc_id)
+
+
+@pytest.fixture()
+def classe_34(monde):
+    """Classe à deux matières, coefficients 14 + 20 = 34 ; l'élève de base
+    (« Eleve », sans note) reste dans la classe. Retourne (mc_a, mc_b)."""
+    _coef(monde, 14)
+    return monde.mc_id, _matiere(monde, 'Français', 20, abreviation='Fr')
+
+
+# ---------------------------------------------------------------------------
+# Utilitaires purs
+# ---------------------------------------------------------------------------
+
+def test_tronquer_et_formater():
+    assert tronquer_2(Decimal('13.45588')) == Decimal('13.45')
+    assert tronquer_2(Decimal('11.6985')) == Decimal('11.69')
+    assert fmt_moyenne(Decimal('8.88')) == '08,88'
+    assert fmt_moyenne(Decimal('15.52')) == '15,52'
+    assert fmt_moyenne(Decimal('20')) == '20,00'
+    assert fmt_points(Decimal('42.5')) == '42,5'
+    assert fmt_points(Decimal('26.00')) == '26'
+    assert fmt_points(Decimal('27.75')) == '27,75'
+    assert fmt_points(Decimal('0')) == '0'
+    assert fmt_rang(8, 'F') == '8e' and fmt_rang(19, 'M') == '19e'
+    assert fmt_rang(1, 'F') == '1ère' and fmt_rang(1, 'M') == '1er'
+    assert nom_affiche('diloga', 'samira') == 'DILOGA Samira'
+
+
+@pytest.mark.parametrize('total,attendue', PHOTO)
+def test_valeurs_photo(total, attendue):
+    moyenne = tronquer_2(Decimal(total) / Decimal(34))
+    assert fmt_moyenne(moyenne) == attendue.replace('.', ',')
+
+
+def test_troncature_et_non_arrondi():
+    """FEUJIO (441,5) et NGOUADJIO (457,5) échoueraient avec un arrondi."""
+    for total, tronque, arrondi in (('441.5', '12.98', '12.99'), ('457.5', '13.45', '13.46'),
+                                    ('397.75', '11.69', '11.70'), ('366.5', '10.77', '10.78')):
+        exacte = Decimal(total) / Decimal(34)
+        assert tronquer_2(exacte) == Decimal(tronque)
+        assert exacte.quantize(Decimal('0.01')) == Decimal(arrondi)
+
+
+def test_abreviation_de_repli(monde):
+    mat = db.session.get(Matiere, monde.matiere_id)
+    assert abreviation_matiere(mat) == 'Mathé'          # 5 premiers caractères
+    mat.abreviation = 'Math'
+    assert abreviation_matiere(mat) == 'Math'
+
+
+# ---------------------------------------------------------------------------
+# Calcul
+# ---------------------------------------------------------------------------
+
+def test_total_ponderee(monde, classe_34):
+    mc_a, mc_b = classe_34
+    insc = _eleve(monde, 'Diloga', 'samira', 'F')
+    _note(monde, insc, mc_a, 12)
+    _note(monde, insc, mc_b, 8.5)
+    pv = _pv(monde)
+    assert pv["total_coef"] == 34
+    d = _ligne(pv, 'Diloga')
+    assert (_cell(d, mc_a)["points"], _cell(d, mc_b)["points"]) == (168.0, 170.0)      # note × coef
+    assert d["total"] == 338.0 and d["total_fmt"] == '338'
+    assert d["moyenne"] == 9.94 and d["moyenne_fmt"] == '09,94'        # 338/34 = 9,941… tronqué
+    assert d["nom_affiche"] == 'DILOGA Samira'
+
+
+def test_valeurs_photo_en_base_troncature(monde, classe_34):
+    """441,5 / 34 = 12,9853 : la moyenne affichée est 12,98 et non 12,99."""
+    mc_a, mc_b = classe_34
+    insc = _eleve(monde, 'Feujio', 'Grâce', 'F')
+    _note(monde, insc, mc_a, 15.25)      # 213,5
+    _note(monde, insc, mc_b, 11.4)       # 228
+    d = _ligne(_pv(monde), 'Feujio')
+    assert d["total_fmt"] == '441,5'
+    assert d["moyenne_fmt"] == '12,98'
+
+
+def test_non_classe(monde, classe_34):
+    mc_a, mc_b = classe_34
+    insc = _eleve(monde, 'Nc')
+    _note(monde, insc, mc_a, 9.25)       # la matière B n'a pas de ligne : non saisie
+    pv = _pv(monde)
+    d = _ligne(pv, 'Nc')
+    assert d["classe"] is False and d["moyenne"] is None and d["rang"] is None
+    assert d["moyenne_fmt"] == '' and d["rang_fmt"] == 'N.C.'
+    assert d["total"] == 129.5 and d["total_fmt"] == '129,5'           # total partiel conservé
+    assert (_cell(d, mc_a)["statut"], _cell(d, mc_b)["statut"]) == ('ok', 'manquante')
+    assert pv["statistiques"]["nb_non_classes"] >= 1
+
+
+def test_absent_vaut_zero(monde, classe_34):
+    mc_a, mc_b = classe_34
+    absent = _eleve(monde, 'Absent')
+    _note(monde, absent, mc_a, absent=True)
+    _note(monde, absent, mc_b, 10)
+    pv = _pv(monde)
+    d = _ligne(pv, 'Absent')
+    assert _cell(d, mc_a)["points"] == 0.0 and _cell(d, mc_a)["statut"] == 'absent'
+    assert _cell(d, mc_a)["rouge"] is True                             # 0 < 10
+    assert d["classe"] is True and d["total"] == 200.0 and d["rang"] == 1
+    # Aucune ligne Note du tout -> non saisie, donc N.C. (jamais confondu avec absent).
+    assert _ligne(pv, 'Eleve')["classe"] is False
+
+
+def test_rouge(monde, classe_34):
+    mc_a, mc_b = classe_34
+    insc = _eleve(monde, 'Rouge')
+    _note(monde, insc, mc_a, 9.99)
+    _note(monde, insc, mc_b, 10)
+    d = _ligne(_pv(monde), 'Rouge')
+    assert _cell(d, mc_a)["rouge"] is True
+    assert _cell(d, mc_b)["rouge"] is False
+    bas = _eleve(monde, 'Bas')
+    _note(monde, bas, mc_a, 8)
+    _note(monde, bas, mc_b, 8)
+    haut = _eleve(monde, 'Haut')
+    _note(monde, haut, mc_a, 10)
+    _note(monde, haut, mc_b, 10)
+    pv = _pv(monde)
+    assert _ligne(pv, 'Bas')["moyenne_rouge"] is True
+    assert _ligne(pv, 'Haut')["moyenne_rouge"] is False                # 10 pile : pas rouge
+
+
+def test_rang_ex_aequo(monde, classe_34):
+    mc_a, mc_b = classe_34
+    for nom, note in (('Aa', 14), ('Bb', 14), ('Cc', 12), ('Dd', 16)):
+        i = _eleve(monde, nom)
+        _note(monde, i, mc_a, note)
+        _note(monde, i, mc_b, note)
+    pv = _pv(monde)
+    assert [(_ligne(pv, n)["rang"]) for n in ('Dd', 'Aa', 'Bb', 'Cc')] == [1, 2, 2, 4]
+    assert _ligne(pv, 'Dd')["rang_fmt"] == '1er' and _ligne(pv, 'Aa')["rang_fmt"] == '2e'
+
+
+def test_rang_exclut_non_classes(monde, classe_34):
+    mc_a, mc_b = classe_34
+    a = _eleve(monde, 'Aa')
+    _note(monde, a, mc_a, 10), _note(monde, a, mc_b, 10)
+    b = _eleve(monde, 'Bb')
+    _note(monde, b, mc_a, 8), _note(monde, b, mc_b, 8)
+    n = _eleve(monde, 'Cc')
+    _note(monde, n, mc_a, 20)            # B manquante : N.C. malgré une très bonne note
+    pv = _pv(monde)
+    assert _ligne(pv, 'Aa')["rang"] == 1 and _ligne(pv, 'Bb')["rang"] == 2
+    assert _ligne(pv, 'Cc')["rang"] is None
+    assert pv["statistiques"]["nb_classes"] == 2
+
+
+def test_classement_sur_valeur_exacte(monde, classe_34):
+    """Deux totaux différents dont les moyennes AFFICHÉES (tronquées) sont
+    égales gardent des rangs distincts : le classement se fait sur la valeur
+    exacte (D2), pas sur la moyenne tronquée."""
+    mc_a, mc_b = classe_34
+    a = _eleve(monde, 'Aa')
+    _note(monde, a, mc_a, 10), _note(monde, a, mc_b, 10.01)     # 340,2 -> 10,0058 -> 10,00
+    b = _eleve(monde, 'Bb')
+    _note(monde, b, mc_a, 10), _note(monde, b, mc_b, 10)        # 340   -> 10,0000 -> 10,00
+    pv = _pv(monde)
